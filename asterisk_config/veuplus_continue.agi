#!/usr/bin/env python3
"""
AGI Script per VeuPlus - Determinar si continuar conversa
"""

import sys
import os
import requests
import json
from datetime import datetime

def log_message(message):
    """Log message to Asterisk"""
    print(f"VERBOSE \"{message}\" 1", flush=True)

def main():
    try:
        # Llegir paràmetres AGI
        call_id = sys.argv[1] if len(sys.argv) > 1 else "unknown"
        
        log_message(f"VeuPlus Continue: {call_id}")
        
        # Cridar API VeuPlus per verificar si continuar
        api_url = "http://localhost:8003/api/sip/should-continue"
        
        payload = {
            "call_id": call_id
        }
        
        response = requests.post(api_url, json=payload, timeout=5)
        
        if response.status_code == 200:
            result = response.json()
            
            if result.get("success"):
                should_continue = result.get("continue", False)
                
                if should_continue:
                    log_message("Continuing conversation")
                    print("SET VARIABLE CONTINUE yes")
                else:
                    log_message("Ending conversation")
                    print("SET VARIABLE CONTINUE no")
            else:
                log_message(f"ERROR: {result.get('error', 'Unknown error')}")
                print("SET VARIABLE CONTINUE no")
        else:
            log_message(f"ERROR: API call failed with status {response.status_code}")
            print("SET VARIABLE CONTINUE no")
            
    except Exception as e:
        log_message(f"ERROR: {str(e)}")
        print("SET VARIABLE CONTINUE no")

if __name__ == "__main__":
    main()











