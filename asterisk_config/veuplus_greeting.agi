#!/usr/bin/env python3
"""
AGI Script per VeuPlus - Generar benvinguda
"""

import sys
import os
import requests
import base64
import json
from datetime import datetime

def log_message(message):
    """Log message to Asterisk"""
    print(f"VERBOSE \"{message}\" 1", flush=True)

def main():
    try:
        # Llegir paràmetres AGI
        caller_id = sys.argv[1] if len(sys.argv) > 1 else "unknown"
        called_number = sys.argv[2] if len(sys.argv) > 2 else "unknown"
        language = sys.argv[3] if len(sys.argv) > 3 else "ca"
        voice_system = sys.argv[4] if len(sys.argv) > 4 else "catalan"
        
        log_message(f"VeuPlus Greeting: {caller_id} -> {called_number} ({language})")
        
        # Cridar API VeuPlus
        api_url = "http://localhost:8003/api/sip/handle-call"
        
        payload = {
            "caller_id": caller_id,
            "called_number": called_number,
            "language": language,
            "voice_system": voice_system
        }
        
        response = requests.post(api_url, json=payload, timeout=10)
        
        if response.status_code == 200:
            result = response.json()
            
            if result.get("success"):
                # Guardar àudio de benvinguda
                audio_base64 = result.get("greeting_audio_base64", "")
                if audio_base64:
                    audio_data = base64.b64decode(audio_base64)
                    
                    audio_path = f"/tmp/veuplus_greeting_{caller_id}_{called_number}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.wav"
                    
                    with open(audio_path, "wb") as f:
                        f.write(audio_data)
                    
                    # Retornar path a Asterisk
                    print(f"SET VARIABLE GREETING_FILE {audio_path}")
                    log_message(f"Greeting generated: {audio_path}")
                    
                    # Guardar call_id per següents passos
                    call_id = result.get("call_id", f"{caller_id}_{called_number}")
                    print(f"SET VARIABLE VEUPLUS_CALL_ID {call_id}")
                    
                else:
                    log_message("ERROR: No audio data received")
                    print("SET VARIABLE GREETING_ERROR 1")
            else:
                log_message(f"ERROR: {result.get('error', 'Unknown error')}")
                print("SET VARIABLE GREETING_ERROR 1")
        else:
            log_message(f"ERROR: API call failed with status {response.status_code}")
            print("SET VARIABLE GREETING_ERROR 1")
            
    except Exception as e:
        log_message(f"ERROR: {str(e)}")
        print("SET VARIABLE GREETING_ERROR 1")

if __name__ == "__main__":
    main()











